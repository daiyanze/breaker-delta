{
  "name": "breaker-delta",
  "version": "0.17.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "breaker-delta",
      "version": "0.17.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@breaker-delta/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@breaker-delta/fetchers": {
      "resolved": "packages/fetchers",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@breaker-delta/core",
      "version": "0.17.0",
      "devDependencies": {
        "typescript": "^5"
      }
    },
    "packages/fetchers": {
      "name": "@breaker-delta/fetchers",
      "version": "0.17.0",
      "dependencies": {
        "@breaker-delta/core": "0.17.0"
      },
      "devDependencies": {
        "typescript": "^5"
      }
    }
  }
}
