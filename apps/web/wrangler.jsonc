{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bd-web",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  // Fonts (issue #104). Files here are served before the Worker runs; the
  // local adapter serves the same files from src/local/fonts.ts.
  "assets": { "directory": "./public" },

  // Per-PR previews (#11). Bindings are not inherited from the top level; any
  // binding added here must name a preview resource
  // (scripts/wrangler-previews.test.ts).
  "previews": {}

  // M3: read-only binding to bd-content and a service binding to bd-pipeline.
  // The web Worker never binds the private database. bd-pipeline binds this
  // Worker's SiteCacheEntrypoint (src/cloudflare/worker.ts) for cache purges.
}
