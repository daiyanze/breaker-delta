enu-link" href="/zh/" hreflang="zh" lang="zh" aria-current="true">中文</a><a class="LanguageMenu-link" href="/ja/" hreflang="ja" lang="ja">日本語</a></div></details></div><h1>Breaker Delta</h1><bd-island name="ThemeSwitch" props="{&quot;toDark&quot;:&quot;切换到深色模式&quot;,&quot;toLight&quot;:&quot;切换到浅色模式&quot;}"><button type="button" class="ThemeSwitch"><svg class="ThemeSwitch-icon" viewBox="0 0 20 20" aria-hidden="true"><circle class="ThemeSwitch-ring" cx="10" cy="10" r="7.5" stroke-width="2"></circle><path class="ThemeSwitch-half" d="M10 2.5 A7.5 7.5 0 0 1 10 17.5 Z"></path></svg><span class="ThemeSwitch-name ThemeSwitch-to-dark">切换到深色模式</span><span class="ThemeSwitch-name ThemeSwitch-to-light">切换到浅色模式</span></button></bd-island></header><main class="page"><section class="Band" aria-labelledby="band-front"><div class="Band-rail"><h2 id="band-front" class="Band-name">海面风平浪静。</h2></div><div class="Band-body"><p>还没有扫描过任何内容。下次扫描：2026-11-19T15:00:00+09:00。</p><p><small>示例数据。</small></p></div></section></main><footer class="Footer"><div class="Footer-top"><nav class="Footer-nav" aria-label="页脚"><a class="Footer-link" href="/zh/about#height"><span class="Footer-long">浪高是怎么算的</span><span class="Footer-short">浪高怎么算</span></a><a class="Footer-link" href="/zh/about#own"><span class="Footer-long">自己架一台雷达</span><span class="Footer-short">自己架一台</span></a><a class="Footer-link" href="/zh/about#open"><span class="Footer-long">Atom 订阅源、API 和开放数据</span><span class="Footer-short">订阅源、API、数据</span></a><a class="Footer-link" href="https://github.com/daiyanze/breaker-delta">GitHub</a></nav></div><div class="Footer-art"><svg class="Footer-svg" viewBox="0 -130 1440 510" role="img" aria-label="礁石上的灯塔把光束扫过起伏的海浪和一艘小帆船"><g class="Footer-beam"><polygon points="1132,92 300,6 300,168"></polygon><polygon points="1132,92 1520,57 1520,137"></polygon></g><path class="Footer-gulls" stroke-width="2.5" d="M560,74 q10,-11 20,0 q10,-11 20,0 M640,112 q8,-9 16,0 q8,-9 16,0 M880,54 q9,-10 18,0 q9,-10 18,0"></path><path class="Footer-solid" d="M1000,310 C1034,252 1086,236 1132,236 C1182,236 1236,256 1268,310 Z"></path><polygon class="Footer-tower" stroke-width="3" points="1108,236 1118,110 1146,110 1156,236"></polygon><polygon class="Footer-red" points="1114.8,150 1149.2,150 1151.2,176 1112.8,176"></polygon><polygon class="Footer-red" points="1110.7,202 1153.3,202 1155.4,228 1108.6,228"></polygon><rect class="Footer-solid Footer-edge" stroke-width="1.5" x="1108" y="104" width="48" height="8"></rect><rect class="Footer-lamp" stroke-width="3" x="1121" y="80" width="22" height="24"></rect><polygon class="Footer-solid Footer-edge" stroke-width="1.5" points="1114,80 1132,58 1150,80"></polygon><g class="Footer-drift Footer-drift-back"><path class="Footer-sky" d="M-480,262 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 q60,-14 120,0 t120,0 V380 H-480 Z"></path></g><g transform="translate(430 250)"><g class="Footer-boat"><path class="Footer-mast" stroke-width="3" d="M0,0 L0,-58"></path><polygon class="Footer-red" points="5,-54 5,-8 40,-8"></polygon><polygon class="Footer-jib" stroke-width="2.5" points="-5,-44 -5,-8 -28,-8"></polygon><path class="Footer-solid Footer-edge" stroke-width="1.5" d="M-38,-2 L38,-2 L26,14 L-26,14 Z"></path></g></g><g transform="translate(-90 0)"><g class="Footer-drift Footer-drift-mid"><path class="Footer-blue" d="M-480,288 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 V380 H-480 Z"></path></g></g><g class="Footer-drift Footer-drift-front"><path class="Footer-solid" d="M-480,320 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 V380 H-480 Z"></path><path class="Footer-hatch" stroke-width="1.5" d="M-480,352 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0"></path></g></svg></div><div class="Footer-bar"><div class="Footer-notes"><span class="Footer-note">Breaker Delta 是开源项目。</span></div></div></footer></body></html>"
