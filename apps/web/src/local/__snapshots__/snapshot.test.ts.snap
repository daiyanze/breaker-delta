*,*::before,*::after{box-sizing:border-box}
html{background:var(--paper);color:var(--ink);font-family:var(--font-body);font-size:var(--type-body-size);line-height:var(--type-body-line);font-variant-numeric:tabular-nums;-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;overflow-wrap:break-word}
button,input,select,textarea{font:inherit;color:inherit}
h1,h2,h3{font-family:var(--font-display)}
a{color:var(--blue)}
img,svg{max-width:100%}
:root{--page-gutter:20px;--band-space:var(--space-7);--band-name-size:32px}
@media (min-width:960px){:root{--page-gutter:var(--space-6);--band-space:var(--space-8);--band-name-size:var(--type-section-size)}}
.page{box-sizing:content-box;max-width:var(--content);margin-inline:auto;padding-inline:var(--page-gutter)}
.band{display:grid;grid-template-columns:minmax(0,1fr);row-gap:var(--space-5);padding-block:var(--band-space);border-top:var(--rule-thin) solid var(--ink)}
.band-rail{display:flex;flex-direction:column;gap:var(--space-3);min-width:0}
.band-name{margin:0;font-family:var(--font-display);font-size:var(--band-name-size);line-height:var(--type-section-line);font-weight:var(--type-section-weight);font-style:var(--type-section-style);letter-spacing:var(--type-section-tracking)}
.band-note{margin:0;color:var(--ink-2)}
.band-body{min-width:0}
.band-body>:first-child{margin-top:0}
@media (min-width:960px){.band{grid-template-columns:minmax(0,var(--rail)) minmax(0,1fr);column-gap:var(--space-8)}.band-rail{position:sticky;top:var(--space-5);align-self:start}}
</style>
</head>
<body>
<header class="page">
<h1>Breaker Delta</h1>
</header>
<main class="page">
<section class="band" aria-labelledby="band-scaffold">
<div class="band-rail">
<h2 id="band-scaffold" class="band-name">Scaffold</h2>
</div>
<div class="band-body">
<p>2.0 scaffold. The site arrives in milestone M3.</p>
</div>
</section>
</main>
</body>
</html>"
