nslate(-90 0)"><g class="Footer-drift Footer-drift-mid"><path class="Footer-blue" d="M-480,288 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 q60,-18 120,0 t120,0 V380 H-480 Z"></path></g></g><g class="Footer-drift Footer-drift-front"><path class="Footer-solid" d="M-480,320 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 q60,-16 120,0 t120,0 V380 H-480 Z"></path><path class="Footer-hatch" stroke-width="1.5" d="M-480,352 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0 q60,-7 120,0 t120,0"></path></g></svg></div><div class="Footer-bar"><div class="Footer-notes"><span class="Footer-note">Breaker Delta 是开源项目。</span></div></div></footer></body></html>"
