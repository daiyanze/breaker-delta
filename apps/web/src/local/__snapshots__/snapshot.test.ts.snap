<!doctype html><html lang="zh"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Breaker Delta</title><script>try{var t=localStorage.getItem("bd-theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t}catch(e){}</script><link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="/fonts/fraunces-italic-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous"/><link rel="stylesheet" href="/client/ui.css"/><script type="module" src="/client/loader.js"></script><meta name="robots" content="noindex"/><link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png"/><link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png"/><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/><link rel="manifest" href="/icons/manifest.webmanifest"/><link rel="alternate" hreflang="en" href="http://site/"/><link rel="alternate" hreflang="zh" href="http://site/zh/"/><link rel="alternate" hreflang="ja" href="http://site/ja/"/><link rel="alternate" hreflang="x-default" href="http://site/"/></head><body><header class="page"><div class="LanguageMenu"><details class="LanguageMenu-details" data-menu><summary class="LanguageMenu-button" aria-label="语言：中文"><svg class="LanguageMenu-icon" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7"></circle><path d="M2 9 H16 M9 2 C5.5 5.5 5.5 12.5 9 16 C12.5 12.5 12.5 5.5 9 2"></path></svg><span class="LanguageMenu-current">中文</span><svg class="LanguageMenu-chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1 L6 6 L11 1"></path></svg></summary><div class="LanguageMenu-list"><a class="LanguageMenu-link" href="/" hreflang="en" lang="en">English</a><a class="LanguageMenu-link" href="/zh/" hreflang="zh" lang="zh" aria-current="true">中文</a><a class="LanguageMenu-link" href="/ja/" hreflang="ja" lang="ja">日本語</a></div></details></div><h1>Breaker Delta</h1><bd-island name="ThemeSwitch" props="{&quot;toDark&quot;:&quot;切换到深色模式&quot;,&quot;toLight&quot;:&quot;切换到浅色模式&quot;}"><button type="button" class="ThemeSwitch"><svg class="ThemeSwitch-icon" viewBox="0 0 20 20" aria-hidden="true"><circle class="ThemeSwitch-ring" cx="10" cy="10" r="7.5" stroke-width="2"></circle><path class="ThemeSwitch-half" d="M10 2.5 A7.5 7.5 0 0 1 10 17.5 Z"></path></svg><span class="ThemeSwitch-name ThemeSwitch-to-dark">切换到深色模式</span><span class="ThemeSwitch-name ThemeSwitch-to-light">切换到浅色模式</span></button></bd-island></header><main class="page"><section class="Band" data-variant="front" aria-labelledby="band-front"><div class="Band-rail"><h2 id="band-front" class="Band-name">头版</h2></div><div class="Band-body"><p>14:00 版。海况：有浪。16 个浪，今天新成 5 个。</p><div class="Headline"><article class="Headline-lead"><p class="Headline-kicker">此刻最高的浪</p><h3 class="Headline-title Headline-title-lead" data-height="196"><a class="Headline-link" href="/zh/topic/chipmaker-board-founder-ceo" lang="zh">芯片厂董事会排除创始人回归 CEO 的可能</a></h3><div class="Headline-figures"><svg class="EchoStack" viewBox="0 0 120 220" role="img" aria-label="回波叠成浪，高 12 层"><rect class="EchoStack-sheet EchoStack-blue" x="4" y="199" width="100" height="11" rx="5.5"></rect><rect class="EchoStack-sheet EchoStack-sky" x="8.6" y="185" width="94" height="11" rx="5.5"></rect><rect class="EchoStack-sheet EchoStack-blue" x="12.7" y="171" width="89" height="11" rx="5.5"></rect><rect class="EchoStack-sheet EchoStack-sky" x="17.3" y="157" width="83" height="11" rx="5.5"></rect><rect class="EchoStack-sheet EchoStack-blue" x="21.4" y="143" width="78" height="11" rx="5.5"></rect><rect class="EchoStack-sheet EchoStack-sky" x="26" y="129" width="72" height="11" rx="5.5"></rect><rect class="EchoStack-sheet EchoStack-blue" x="30.6" y="1