{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "浪尖雷达 · 收波"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://github.com/*",
        "https://news.ycombinator.com/*",
        "https://*.reddit.com/*",
        "https://x.com/*",
        "https://*.producthunt.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "浪尖雷达 / Breaker Delta 的收波扩展：一键收下当前页面的回波，并在已收录话题的页面上显示浪高徽章。",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "浪尖雷达 · 收波 — Breaker Delta Echo Catcher",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "short_name": "浪尖雷达收波",
  "version": "0.6.1",
  "web_accessible_resources": [
    {
      "matches": [
        "https://github.com/*",
        "https://news.ycombinator.com/*",
        "https://*.reddit.com/*",
        "https://x.com/*",
        "https://*.producthunt.com/*"
      ],
      "resources": [
        "data/topics.json",
        "data/alerts.json"
      ]
    }
  ]
}
