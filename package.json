{
  "name": "breaker-delta",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:deps",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check:deps": "bun scripts/check-deps.ts",
    "probe": "bun scripts/probe-sources.ts",
    "local": "bun apps/local/start.ts",
    "build:local": "bun build apps/local/start.ts --compile --outfile dist/breaker-delta"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/bun": "latest",
    "miniflare": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
