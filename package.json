{
  "name": "breaker-delta",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:deps",
    "typecheck": "bun --filter '*' typecheck && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check:deps": "bun scripts/check-deps.ts",
    "probe": "bun scripts/probe-sources.ts",
    "record-fixture": "bun scripts/record-fixture.ts",
    "local": "bun apps/local/start.ts",
    "icons": "bun scripts/build-icons.ts",
    "build:local": "bun build apps/local/start.ts --compile --outfile dist/breaker-delta"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.4",
    "miniflare": "5.20261117.0-beta",
    "typescript": "7.0.2",
    "wrangler": "^4.164.0"
  }
}
