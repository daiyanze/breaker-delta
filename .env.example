# Breaker Delta self-hosted instance — copy to .env and fill in.
# Every variable is optional; the defaults run a read-only local radar.

# Bearer token for the push API your agent uses to deliver graded
# work (POST /api/record, POST /api/editions). Leave unset or empty
# for a read-only server. Use a long random string.
# BD_PUSH_TOKEN=

# Public base URL of this instance — used in canonical links, feeds
# and the sitemap. Unset = http://localhost:8080/.
# BD_BASE_URL=https://radar.example.com/

# Built-in scan schedule, container local time (comma-separated
# HH:MM). Scans only fetch candidates; grading stays with your
# agent, which pushes the finished edition through the API.
# Unset = no built-in scans.
# BD_SCAN_TIMES=06:00,18:00

# Container timezone (drives BD_SCAN_TIMES and edition dating).
TZ=Asia/Tokyo
