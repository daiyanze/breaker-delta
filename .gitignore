# Claude Code agent worktrees: full checkouts, each with its own biome.json
.claude/worktrees/

# The client files wrangler's build command writes (ADR 0020, section 11)
apps/web/public/client/
# Bun 1.4 leaves one of these in the working folder after each `bun build --compile`
.*.bun-build

# The screenshot check (#258): its output, and baselines made on an OS
# other than the CI job's Linux, which are for a local before and after only
apps/web/screenshots/*
!apps/web/screenshots/linux/
.ui-screens/
